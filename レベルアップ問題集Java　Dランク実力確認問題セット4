import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int N = sc.nextInt();
        String S = sc.next();
        String T = sc.next();

        if (S.compareTo(T) > 0) {
            System.out.println("Yes");
        } else {
            System.out.println("No");
        }

        sc.close();
    }
}
/*今回の問題では S,T は最大で 100 桁の整数になるため、一般的な 64 ビット整数では扱えません。
そこで、S と T を文字列として受け取り、大小比較をする方法を考えます。
S, T の上から i 桁目の値を S_i, T_i と表します。
k を S_k ≠ T_k を満たす最小の k とすると、答えは以下の通りです。
・S_k > T_k の場合 : 答えは Yes
・S_k < T_k の場合 : 答えは No*/
